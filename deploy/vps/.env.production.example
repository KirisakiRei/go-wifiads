# Wi-Fi Ads — production env template.
# Copy to ../.env on the VPS, then fill every <CHANGE_ME>.
# This file is committed; the filled .env never is.

# --- Application ---
APP_ENV=production
APP_NAME=WiFi Ads
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- PostgreSQL (service name from docker-compose.yml) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=wifiads
DB_PASSWORD=<CHANGE_ME>
DB_NAME=wifi_advertising
DB_SSLMODE=disable
# Keep the pool small: 1 GB host, max_connections=30 in postgres.
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME_MINUTES=60

# --- Admin authentication ---
# openssl rand -base64 48   (must be >= 32 characters)
JWT_SECRET=<CHANGE_ME>
JWT_ISSUER=wifiads-api
JWT_EXPIRY_HOURS=12
JWT_COOKIE_NAME=wifiads_admin
JWT_COOKIE_SECURE=true

# --- Portal ---
PORTAL_PUBLIC_BASE_URL=https://wifiads.smartscales.web.id
PORTAL_AD_DURATION_SECONDS=5
PORTAL_SESSION_TTL_SECONDS=900
PORTAL_VOUCHER_TTL_SECONDS=3600
PORTAL_SESSION_TIMEOUT_SECONDS=3600
PORTAL_VOUCHER_PASSWORD_LENGTH=12
PORTAL_VOUCHER_USERNAME_PREFIX=wf
# Redirect targets allowed to start a portal session. Comma separated.
# The MikroTik LAN gateway goes here, e.g. 10.10.0.1
PORTAL_ALLOWED_LOGIN_HOSTS=<CHANGE_ME>
PORTAL_DEV_MODE=false

# --- RADIUS ---
RADIUS_AUTH_ADDR=:1812
RADIUS_ACCT_ADDR=:1813
RADIUS_STALE_AFTER_SECONDS=900
RADIUS_EVENT_RETENTION_DAYS=30

# --- Secret encryption (AES-256-GCM, 32 bytes) ---
# Generate each with: openssl rand -base64 32
# Changing these later makes existing encrypted values unreadable.
VOUCHER_ENC_KEY=<CHANGE_ME>
RADIUS_SECRET_ENC_KEY=<CHANGE_ME>

# --- Initial seed (applied once by the migrate step) ---
SEED_ADMIN_USERNAME=admin
# openssl rand -base64 18
SEED_ADMIN_PASSWORD=<CHANGE_ME>
SEED_ADMIN_NAME=Administrator
SEED_SITE_NAME=SmartScales WiFi
SEED_SITE_TIMEZONE=Asia/Jakarta
SEED_ROUTER_NAME=wifiads-router
SEED_ROUTER_IP=10.10.0.1
SEED_NAS_IDENTIFIER=wifiads-router
SEED_NAS_IP=10.10.0.1
# Must match "secret=" on /radius in MikroTik. Required in production.
SEED_NAS_SHARED_SECRET=<CHANGE_ME>
SEED_AD_TITLE=Wi-Fi Gratis
SEED_AD_BODY=Nikmati akses internet gratis. Tunggu hitung mundur selesai lalu tekan Connect.
SEED_AD_IMAGE_URL=/static/img/ad-placeholder.svg
