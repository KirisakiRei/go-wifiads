# --- Application ---
APP_ENV=development
APP_NAME=WiFi Ads Alpha
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- PostgreSQL (native install, no Docker required) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wifi_advertising
DB_SSLMODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME_MINUTES=60

# --- Admin authentication ---
JWT_SECRET=change-me-development-secret-at-least-32-chars
JWT_ISSUER=wifiads-api
JWT_EXPIRY_HOURS=12
JWT_COOKIE_NAME=wifiads_admin
JWT_COOKIE_SECURE=false

# --- Portal ---
PORTAL_PUBLIC_BASE_URL=http://localhost:8080
PORTAL_AD_DURATION_SECONDS=5
PORTAL_SESSION_TTL_SECONDS=900
PORTAL_VOUCHER_TTL_SECONDS=300
PORTAL_SESSION_TIMEOUT_SECONDS=3600
PORTAL_VOUCHER_PASSWORD_LENGTH=12
PORTAL_VOUCHER_USERNAME_PREFIX=wf
# Comma separated hosts (or *.example.com). Required in production.
PORTAL_ALLOWED_LOGIN_HOSTS=
# Allows running the portal without a real MikroTik (link-login-only empty).
PORTAL_DEV_MODE=true

# --- RADIUS ---
RADIUS_AUTH_ADDR=:1812
RADIUS_ACCT_ADDR=:1813
RADIUS_STALE_AFTER_SECONDS=900
RADIUS_EVENT_RETENTION_DAYS=30

# --- Secret encryption (AES-256-GCM, 32 bytes; base64 or hex) ---
# Generate with: openssl rand -base64 32
VOUCHER_ENC_KEY=
RADIUS_SECRET_ENC_KEY=

# --- Initial seed data (cmd/migrate) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Alpha Administrator
SEED_SITE_NAME=Alpha Site
SEED_SITE_TIMEZONE=Asia/Jakarta
SEED_ROUTER_NAME=alpha-router-01
SEED_ROUTER_IP=192.168.88.1
SEED_NAS_IDENTIFIER=alpha-router-01
SEED_NAS_IP=192.168.88.1
SEED_NAS_SHARED_SECRET=testing123
SEED_AD_TITLE=Wi-Fi Gratis
SEED_AD_BODY=Nikmati akses internet gratis. Tunggu hitung mundur selesai lalu tekan Connect.
SEED_AD_IMAGE_URL=/static/img/ad-placeholder.svg
